# Example only. npm start does not automatically load this file.
# To use a private .env: node --env-file=.env server.cjs
PORT=3000
FIRMA_HOST=127.0.0.1
FIRMA_DATA_DIR=.firma-private
# Defaults to FIRMA_DATA_DIR/projects. Preserve the whole data directory.
# FIRMA_PROJECTS_DIR=/srv/firma/data/projects
FIRMA_EXECUTOR=local
FIRMA_REMOTE_ADMIN=0
FIRMA_READ_ONLY_ROOT=0
FIRMA_BACKUP_HOURS=24
# Use a separate disk/directory and copy it off the machine.
# FIRMA_BACKUP_DIR=/srv/firma/backups
# FIRMA_PUBLIC_ORIGIN=https://firma.example.com
# FIRMA_TRUSTED_PROXY=127.0.0.1
# FIRMA_LOG=json
# Optional isolated executor (must be prepared before enabling remote administration):
# FIRMA_EXECUTOR=docker
# FIRMA_RUNNER_IMAGE=node:22-bookworm-slim
# FIRMA_INSTALL_NETWORK=bridge
# FIRMA_RUNNER_USER=1000:1000
# Rootless Docker: use your daemon's Unix socket and its container UID mapping.
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# FIRMA_RUNNER_USER=0:0
# GEMINI_API_KEY=configure-outside-git
